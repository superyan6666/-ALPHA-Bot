# ============================================
# A-Bot 量化系统 - 环境变量配置模板
# ============================================

# --------------------------------------------
# 1. 钉钉机器人配置 (用于推送通知)
# --------------------------------------------
# 获取方式：钉钉群设置 -> 群机器人 -> 自定义 -> 添加 -> 获取 Webhook
DINGTALK_WEBHOOK=https://oapi.dingtalk.com/robot/send?access_token=xxxxxx

# --------------------------------------------
# 2. Tushare 配置 (可选，用于高级数据源)
# --------------------------------------------
# 获取方式：https://tushare.pro/register?reg=xxxxx
# 注意：积分低于 2000 分无法使用全市场基本面接口
TUSHARE_TOKEN=你的_tushare_token

# --------------------------------------------
# 3. 系统配置 (可选)
# --------------------------------------------
# 运行模式: normal | market_only | test_conn | briefing
RUN_MODE=normal

# 数据缓存模式: online | offline
DATA_CACHE_MODE=online

# 离线模式最大缓存天数
OFFLINE_MAX_AGE_DAYS=7

# 是否推送空结果: true | false
PUSH_EMPTY_RESULT=true

# 日志级别: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# ============================================
# 使用说明：
# 1. 复制此文件为 .env 并填入真实值
# 2. 在运行程序前执行: source .env
# 3. 或者在 GitHub Actions Secrets 中配置这些值
# ============================================
